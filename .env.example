# PostgreSQL connection string. URL-encode any special characters in the password
# (e.g. "@" -> "%40"). The app validates this at startup and refuses to boot without it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Port the backend HTTP server listens on.
PORT=4100

# development | production | test — controls secure-cookie enforcement, logging verbosity,
# and error detail exposure. Must be "production" on the real server.
NODE_ENV=development

# Public URL of this backend API (used for cookie/CORS configuration).
APP_URL=http://localhost:4100

# Public URL of the deployed frontend (used for CORS allow-origin and cookie SameSite policy).
FRONTEND_URL=http://localhost:5173

# Long random secret used to sign session cookies (minimum 32 characters).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the development value in production.
SESSION_SECRET=

# --- Optional (sensible production defaults are built in) ---

# Failed+successful login attempts allowed per IP per window. Leave at the default
# in production; raise it only when running the Playwright suite, which performs
# many logins from one address.
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Origins allowed to call the public "report a problem" endpoints — the
# KStack service sites the embeddable widget runs on (kauindex.com,
# planner subdomain, etc.), each exactly as it appears in the browser's
# Origin header (scheme + host, no path, no trailing slash). Separate from
# FRONTEND_URL above, which covers only the session-authenticated dashboard
# API. Comma-separated; empty means no outside site can reach the widget yet.
# SUPPORT_WIDGET_ORIGINS=https://kauindex.com,https://planner.kauindex.com

# Throttling for the public support endpoints, keyed by IP since there is no
# session or login wall to throttle by instead. Leave at the defaults in
# production; raise only for automated test runs.
# SUPPORT_RATE_LIMIT_MAX=30
# SUPPORT_CREATE_RATE_LIMIT_MAX=5

# Cookie scope for the session (and its CSRF companion).
#
# Leave EMPTY in development — a browser rejects a ".kstacks.org" cookie served
# from localhost.
#
# In production set it to ".kstacks.org" to share the session across KStack
# subdomains. Note what this buys and costs: any host under kstacks.org will
# have the session cookie sent to it, so every subdomain must stay trusted.
# Leaving it empty keeps the cookie host-only (dashboard-only), which is the
# stricter option.
# SESSION_COOKIE_DOMAIN=.kstacks.org

# Comma-separated list of email domains allowed to sign in. Anything else is
# rejected before the account lookup. Being on an allowed domain is necessary
# but not sufficient — the address must also be on the roster in prisma/seed.ts.
# ALLOWED_EMAIL_DOMAINS=stu.kau.edu.sa

# Background probing of service health URLs. Disable if you would rather not have
# the API make outbound requests on a timer.
# HEALTH_CHECK_ENABLED=true
# HEALTH_CHECK_INTERVAL_MINUTES=5

# Background refresh of the public service catalogue from the KStacks site. A
# service launched there appears in the dashboard on the next run, with its
# tagline, status, link and logo — no manual step. Team-authored fields
# (overview, repo, health URL, owner) are never touched by a sync.
#
# Set SERVICE_SYNC_ENABLED=false to freeze the catalogue and manage it by hand
# with `pnpm --filter backend db:sync-services`.
# SERVICE_SYNC_ENABLED=true
# SERVICE_SYNC_INTERVAL_HOURS=24
# SERVICE_CATALOG_URL=https://kstacks.org/

# GitHub activity feed. Without a token GitHub allows 60 requests/hour, which one
# refresh nearly exhausts; a read-only token raises the ceiling to 5000.
# GITHUB_ORG=KStacks-org
# GITHUB_TOKEN=
# GITHUB_CACHE_MINUTES=20

# --- Service tokens (JWT) ---
#
# The dashboard signs a short-lived token describing who someone is and what
# they administer, which the other KStack services read. RS256, not a shared
# secret: only the dashboard holds the private key, and every service verifies
# against the public half published at /.well-known/jwks.json. A shared secret
# would let any service mint an admin token for anyone.
#
# REQUIRED in production — the app refuses to boot without it. In development a
# throwaway key is generated at startup, so every restart invalidates the tokens
# it signed.
#
# Generate one (PKCS8, base64 so it fits on a single line):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0
#
# A literal multi-line PEM also works. Treat this exactly like SESSION_SECRET:
# anyone holding it can impersonate any member of the team on any service.
# JWT_PRIVATE_KEY=

# Claims every consumer should check. Change them only in agreement with the
# services that verify the token.
# JWT_ISSUER=https://kstacks.org
# JWT_AUDIENCE=kstacks-services

# Deliberately short: the token carries authority, so revoking a scope should
# take effect quickly. Consumers re-fetch rather than cache it.
# JWT_TTL_MINUTES=15
