# PostgreSQL connection string. URL-encode any special characters in the password
# (e.g. "@" -> "%40"). The app validates this at startup and refuses to boot without it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Port the backend HTTP server listens on.
PORT=4000

# development | production | test — controls secure-cookie enforcement, logging verbosity,
# and error detail exposure. Must be "production" on the real server.
NODE_ENV=development

# Public URL of this backend API (used for cookie/CORS configuration).
APP_URL=http://localhost:4000

# Public URL of the deployed frontend (used for CORS allow-origin and cookie SameSite policy).
FRONTEND_URL=http://localhost:5173

# Long random secret used to sign session cookies (minimum 32 characters).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the development value in production.
SESSION_SECRET=

# --- Optional (sensible production defaults are built in) ---

# Failed+successful login attempts allowed per IP per window. Leave at the default
# in production; raise it only when running the Playwright suite, which performs
# many logins from one address.
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
