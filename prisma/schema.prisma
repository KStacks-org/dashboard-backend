generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

/// Where a task sits in the team's workflow. "Done" is not a status — finishing
/// a task archives it (see Task.isArchived), which is never a destructive delete.
enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
}

/// Everyone works with equal permissions; ADMIN additionally manages the roster.
enum UserRole {
  ADMIN
  MEMBER
}

/// A defect that exists, as opposed to a Task, which is work to be done.
enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NotificationType {
  TASK_ASSIGNED
  SUBTASK_ASSIGNED
  COMMENT_MENTION
  ISSUE_ASSIGNED
  DEADLINE_SOON
}

enum ServiceStatus {
  LIVE
  BETA
  COMING_SOON
}

/// Pipeline states for a student project the team sponsors under "Powered by KStack".
enum SponsoredProjectStatus {
  PROPOSED
  IN_REVIEW
  ACTIVE
  LAUNCHED
  ARCHIVED
}

model User {
  id String @id @default(uuid())

  /// The login identifier. Must sit on an allowed university domain and be on
  /// the roster — there is no public sign-up, so this table *is* the allowlist.
  email String @unique @db.VarChar(200)

  /// Stable internal key used by the seed to update a row in place, so a
  /// corrected email never creates a duplicate account. Not exposed by the API.
  username    String   @unique @db.VarChar(50)
  displayName String   @map("display_name") @db.VarChar(100)
  role        UserRole @default(MEMBER)

  /// Roster profile shown on the Team page, maintained by an admin.
  jobTitle         String?  @map("job_title") @db.VarChar(120)
  /// Free text so it can name internal repos (Infrastructure, Auth Service)
  /// that are not public KStack services.
  responsibilities String[] @default([])

  /// Soft-off switch: a removed member keeps their authored history but can no
  /// longer sign in or be assigned new work.
  isActive           Boolean  @default(true) @map("is_active")
  passwordHash       String   @map("password_hash")
  mustChangePassword Boolean  @default(true) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdTasks     Task[]         @relation("TaskCreator")
  assignedTasks    TaskAssignee[]
  assignedSubtasks Subtask[]      @relation("SubtaskAssignee")
  comments         TaskComment[]
  ownedServices    Service[]      @relation("ServiceOwner")
  assignedIssues   Issue[]        @relation("IssueAssignee")
  reportedIssues   Issue[]        @relation("IssueReporter")
  notifications    Notification[] @relation("NotificationRecipient")
  triggered        Notification[] @relation("NotificationActor")

  @@index([isActive])
  @@map("users")
}

model Service {
  id          String        @id @default(uuid())
  name        String        @db.VarChar(100)
  codename    String        @unique @db.VarChar(50)
  tagline     String        @db.VarChar(200)
  description String        @db.Text
  status      ServiceStatus @default(LIVE)
  url         String?       @db.VarChar(300)
  sortOrder   Int           @default(0) @map("sort_order")

  /// Team-authored fields. The kstacks.org sync script never overwrites these —
  /// it only refreshes the public catalogue fields above.
  overview       String? @db.Text
  repoUrl        String? @map("repo_url") @db.VarChar(300)
  healthCheckUrl String? @map("health_check_url") @db.VarChar(300)

  ownerId String? @map("owner_id")
  owner   User?   @relation("ServiceOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tasks        Task[]
  healthChecks ServiceHealthCheck[]
  issues       Issue[]

  @@index([ownerId])
  @@map("services")
}

/// One recorded probe of a service's health endpoint.
model ServiceHealthCheck {
  id             String   @id @default(uuid())
  serviceId      String   @map("service_id")
  service        Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  isUp           Boolean  @map("is_up")
  statusCode     Int?     @map("status_code")
  responseTimeMs Int?     @map("response_time_ms")
  error          String?  @db.VarChar(300)
  checkedAt      DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)

  @@index([serviceId, checkedAt])
  @@map("service_health_checks")
}

model Task {
  id String @id @default(uuid())

  /// Short human reference (rendered as "KS-42") so tasks can be named in chat.
  reference Int @unique @default(autoincrement())

  title       String     @db.VarChar(200)
  description String?    @db.Text
  deadline    DateTime?  @db.Timestamptz(6)
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  isArchived  Boolean    @default(false) @map("is_archived")
  archivedAt  DateTime?  @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  serviceId String?  @map("service_id")
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  createdById String @map("created_by")
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  milestoneId String?    @map("milestone_id")
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  assignees     TaskAssignee[]
  subtasks      Subtask[]
  comments      TaskComment[]
  links         TaskLink[]
  notifications Notification[]
  fromIssue     Issue?         @relation("IssueConvertedTask")

  @@index([deadline])
  @@index([milestoneId])
  @@index([serviceId])
  @@index([createdById])
  @@index([isArchived])
  @@index([status])
  @@map("tasks")
}

model TaskAssignee {
  taskId     String   @map("task_id")
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

model Subtask {
  id          String  @id @default(uuid())
  taskId      String  @map("task_id")
  task        Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String  @db.VarChar(200)
  isCompleted Boolean @default(false) @map("is_completed")
  sortOrder   Int     @default(0) @map("sort_order")

  /// A subtask carries at most one owner, and that person must already be an
  /// assignee of the parent task. Enforced in the service layer; SetNull here
  /// only covers the case of the user record itself being removed.
  assigneeId String? @map("assignee_id")
  assignee   User?   @relation("SubtaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([taskId])
  @@index([assigneeId])
  @@map("subtasks")
}

model TaskComment {
  id       String @id @default(uuid())
  taskId   String @map("task_id")
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body     String @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([taskId, createdAt])
  @@index([authorId])
  @@map("task_comments")
}

model TaskLink {
  id     String  @id @default(uuid())
  taskId String  @map("task_id")
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  url    String  @db.VarChar(2000)
  label  String? @db.VarChar(120)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([taskId])
  @@map("task_links")
}

/// A student project the team sponsors with hosting/infrastructure — the
/// internal counterpart to the public "Powered by KStack" section.
model SponsoredProject {
  id          String                 @id @default(uuid())
  name        String                 @db.VarChar(120)
  description String                 @db.Text
  ownerName   String                 @map("owner_name") @db.VarChar(120)
  contact     String?                @db.VarChar(200)
  projectUrl  String?                @map("project_url") @db.VarChar(300)
  repoUrl     String?                @map("repo_url") @db.VarChar(300)
  status      SponsoredProjectStatus @default(PROPOSED)
  /// What the team actually provided (hosting, database, domain, support).
  resources   String?                @db.Text
  notes       String?                @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@map("sponsored_projects")
}

/// Backing table for connect-pg-simple's express-session store.
model Session {
  sid    String   @id @db.VarChar
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

/// A dated goal that tasks roll up into, e.g. "Portal MVP".
model Milestone {
  id          String    @id @default(uuid())
  title       String    @db.VarChar(150)
  description String?   @db.Text
  deadline    DateTime? @db.Timestamptz(6)
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tasks Task[]

  @@map("milestones")
}

/// Something that is broken, tracked separately from the work to fix it. An
/// issue can be promoted into a Task, after which the two stay linked.
model Issue {
  id        String @id @default(uuid())
  reference Int    @unique @default(autoincrement())

  title       String      @db.VarChar(200)
  description String?     @db.Text
  priority    Priority    @default(MEDIUM)
  status      IssueStatus @default(OPEN)

  serviceId String?  @map("service_id")
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  assigneeId String? @map("assignee_id")
  assignee   User?   @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  reportedById String @map("reported_by")
  reportedBy   User   @relation("IssueReporter", fields: [reportedById], references: [id], onDelete: Restrict)

  /// Set once the issue has been converted; SetNull keeps the issue if the
  /// task it produced is later deleted.
  convertedTaskId String? @unique @map("converted_task_id")
  convertedTask   Task?   @relation("IssueConvertedTask", fields: [convertedTaskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  notifications Notification[]

  @@index([status])
  @@index([serviceId])
  @@index([assigneeId])
  @@map("issues")
}

model Notification {
  id     String           @id @default(uuid())
  type   NotificationType
  body   String           @db.VarChar(300)
  isRead Boolean          @default(false) @map("is_read")

  userId String @map("user_id")
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  /// Who caused it. Null for system-generated ones such as deadline reminders.
  actorId String? @map("actor_id")
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  taskId  String? @map("task_id")
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  issueId String? @map("issue_id")
  issue   Issue?  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}
